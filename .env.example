# ==========================================
# KR DIGITAL MARKETING & STUDIOZ — ENV VARS
# ==========================================

# 1. Supabase Connection (Required for Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Resend Email Notifications (Required for Enquiry Form Email Alerts)
# IMPORTANT: Keep RESEND_API_KEY server-side ONLY. Do NOT add NEXT_PUBLIC_ prefix!
RESEND_API_KEY=re_123456789_your_resend_api_key
NOTIFICATION_EMAIL=kr.digital.studioz@gmail.com

# 3. Optional Cloudinary (For direct media file uploads in admin)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
